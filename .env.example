# Copie a .env y configure los valores antes de iniciar el backend.
DB_URL=jdbc:postgresql://localhost:5432/hcg_multiservicios?sslmode=require
DB_USER=postgres
DB_PASSWORD=replace-with-your-database-password

# Minimo 32 caracteres aleatorios.
HCG_JWT_SECRET=
HCG_JWT_EXPIRATION_MINUTES=480
HCG_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Primer administrador (solo se usa si la tabla usuario esta vacia).
HCG_ADMIN_USERNAME=admin
HCG_ADMIN_EMAIL=admin@hcg.pe
HCG_ADMIN_PASSWORD=

# Facturacion electronica APIsPERU.
APISPERU_URL=https://facturacion.apisperu.com/api/v1/invoice/send
APISPERU_TOKEN=replace-with-your-apisperu-token
APISPERU_COMPANY_RUC=20026788123
APISPERU_COMPANY_RAZON_SOCIAL=MULTISERVICIOS HCG E.I.R.L.
